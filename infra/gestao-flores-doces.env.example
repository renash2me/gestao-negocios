# =============================================================================
# gestao-flores-doces.env - copie para gestao-flores-doces.env e preencha
# Para novos clientes: crie um novo .env com DOMAIN e BUSINESS_NAME diferentes
# =============================================================================

# Dominio da aplicacao (sem https://)
DOMAIN=floresedoces.renashstudios.com

# Nome do negocio (aparece na UI e nos relatorios)
BUSINESS_NAME=Flores e Doces

# URL do logo (opcional - deixar vazio usa o padrao)
BUSINESS_LOGO_URL=

# Banco de dados - USE SENHAS FORTES EM PRODUCAO
POSTGRES_USER=gestao
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=gestao_flores

# JWT - gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Taxas padrao (podem ser sobrescritas por maquininha no admin)
DEFAULT_CARD_FEE_PERCENT=2.0

# Tarifa de energia em R$/kWh (referencia para novos cadastros)
DEFAULT_KWH_RATE=0.75

# -----------------------------------------------------------------------------
# Primeiro admin - usado UMA VEZ pelo comando seed_admin.
# Depois de criar o admin, pode remover ou deixar (o comando nao recria).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_ADMIN
ADMIN_NAME=Renato
